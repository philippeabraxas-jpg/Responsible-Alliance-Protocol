## Monitoring & Alerting Pattern

```python
import logging
from tbp import enforce_tbp

# Set up structured logging
logger = logging.getLogger("tbp")
logger.setLevel(logging.WARNING)

def monitored_enforce(action):
    """Enforcement with monitoring"""
    result = enforce_tbp(action)
    
    if not result.allowed:
        # Log violation
        logger.critical({
            "event": "tbp_violation",
            "invariant": result.violated.value,
            "action_type": action.type,
            "target": action.target,
            "timestamp": datetime.utcnow().isoformat()
        })
        
        # Send alert
        send_alert(
            severity="CRITICAL",
            message=f"TBP violation: {result.violated.value}",
            details=result.reason
        )
    
    return result
```

