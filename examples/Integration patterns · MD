## AutoGen Integration

```python
from autogen import Agent
from tbp import enforce_tbp, Action

class TBPAgent(Agent):
    """AutoGen agent with TBP enforcement"""
    
    def execute_function(self, func_call):
        action = Action(
            type=func_call["name"],
            target=func_call.get("arguments", {}).get("target", ""),
            params=func_call.get("arguments", {})
        )
        
        result = enforce_tbp(action)
        
        if not result.allowed:
            return {
                "success": False,
                "error": f"TBP violation: {result.violated.value}",
                "reason": result.reason
            }
        
        return super().execute_function(func_call)
```

