## Middleware Pattern (Framework-Agnostic)

```python
from functools import wraps
from tbp import enforce_tbp, Action

def tbp_enforce(func):
    """Decorator to add TBP enforcement to any function"""
    
    @wraps(func)
    def wrapper(*args, **kwargs):
        action = Action(
            type=func.__name__,
            target=kwargs.get("target", args[0] if args else ""),
            params=kwargs
        )
        
        result = enforce_tbp(action)
        
        if not result.allowed:
            raise TBPViolationError(
                f"{result.violated.value}: {result.reason}"
            )
        
        return func(*args, **kwargs)
    
    return wrapper

# Usage
@tbp_enforce
def execute_trade(symbol, quantity):
    # Trading logic here
    pass

@tbp_enforce
def access_infrastructure(target, command):
    # Infrastructure access here
    pass
```

