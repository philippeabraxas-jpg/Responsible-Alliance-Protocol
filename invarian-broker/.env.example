# Copier en .env et remplir. Ne jamais committer le .env réel.

BROKER_HOST=127.0.0.1
BROKER_PORT=8090

# Liste blanche stricte, séparée par des virgules. Vide = CORS bloque tout
# (fail-closed). Mettre ici le(s) domaine(s) exact(s) de la landing page.
ALLOWED_ORIGINS=https://votre-landing-page.example.com

GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-1.5-pro
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=deepseek-coder:1.3b

OPA_URL=http://localhost:8181
MCP_CONFIG_PATH=/etc/invarian/mcp_servers/config.json

# Token requis en header X-Admin-Token pour appeler /api/panic.
# Vide = endpoint désactivé.
ADMIN_TOKEN=

MAX_PAYLOAD_CHARS=8000
MAX_BODY_BYTES=65536
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60
SESSION_TTL=3600
